# ---------------------------------------------------------------------------
# EduAI — ingestion image.
#
# The service image is the one a student waits on: it starts when a deploy
# rolls, and every megabyte in it is a megabyte of cold start. The layout
# models this image carries are gigabytes, and they are needed by a job that
# runs when a book is ingested and then stops. So they live here instead, and
# the two images share the same source tree and the same config.
#
# Built by the same workflow, pushed to its own repository, and run as an ECS
# task rather than a service:
#
#   aws ecs run-task --cluster edu-ai-ai --task-definition edu-ai-ingest \
#     --overrides '{"containerOverrides":[{"name":"ingest",
#       "command":["s3://bucket/book.pdf","--lecture-id","...","--subject-id",
#                  "...","--layout-model"]}]}'
# ---------------------------------------------------------------------------
FROM python:3.11-slim AS builder

ENV PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=10 \
    PIP_NO_CACHE_DIR=1

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /app
COPY requirements.txt requirements-ingest.txt ./
# requirements-ingest.txt (paddleocr + paddlepaddle) is deliberately not
# installed. It is the layout tier, ingestion.layout.tier2 is false, and it has
# read zero pages in production — every one of the 2,982 so far went to the
# vision model. It was 1.5 GB of the image, downloaded again on every task
# start, for software never loaded.
RUN pip install --no-compile --index-url https://download.pytorch.org/whl/cpu torch==2.13.0 \
    && pip install --no-compile -r requirements.txt

# ---------------------------------------------------------------------------
FROM python:3.11-slim AS runtime

# OpenCV wants these; it comes in with the document tooling and does not ship
# its own.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HF_HOME=/opt/models

COPY agent/ agent/
COPY shared/ shared/
COPY ingestion/ ingestion/
COPY system/ system/
COPY scripts/ scripts/
COPY config.yaml .

RUN useradd --create-home --uid 1000 appuser \
    && mkdir -p /opt/models && chown -R appuser /opt/models
USER appuser

# The embedder, fetched at build time rather than at run time. Every task was
# pulling BGE-M3 from HuggingFace on first use — 2.2 GB per run, through the
# NAT Gateway, before a single page was read. Measured over September: 303 GB
# of the 316 GB that gateway processed was task startup, not page reading.
# Baked here it arrives with the image, which is the thing a task has to fetch
# anyway.
RUN python -c "from shared.config import get_config; \
    from shared.embeddings import get_embedder; get_embedder(get_config())"

# python, not `python -m ingestion`: a task override replaces the command, and
# the same image has to be able to run the comparison script as well as the
# ingester. The default command is still an ingest.
ENTRYPOINT ["python"]
CMD ["-m", "ingestion"]
