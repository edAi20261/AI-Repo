# Settings for running an ingest on your own machine.
#
# Copy this file to `.env.ingest` and fill in the blanks. `.env.ingest` is
# ignored by git and must never be committed or shared — it holds live keys.
#
# Ask the AI team for every value marked ASK. Do not guess them and do not copy
# them from anywhere else: these reach the live database, and a wrong one
# either fails loudly or writes to the wrong place.

# Where lessons, chunks and the page cache are stored.
DATABASE_URL=ASK

# The search index the finished chunks go into.
QDRANT_URL=ASK
QDRANT_API_KEY=ASK

# Where page images and figure crops are kept.
S3_BUCKET=ASK
S3_REGION=eu-central-1
AWS_ACCESS_KEY_ID=ASK
AWS_SECRET_ACCESS_KEY=ASK

# The Google service account that pays for reading the pages. This is the whole
# contents of the JSON file on one line, not a path to it — the container has no
# access to files on your machine except the books folder.
GOOGLE_APPLICATION_CREDENTIALS=ASK

# Where the platform is told a lesson is ready. Leave both blank to ingest
# without telling it anything, which is what an external book wants.
BACKEND_API_BASE_URL=
AI_WEBHOOK_SHARED_SECRET=

# Keep this. It stops the container trying to download the embedding model,
# which is already inside the image.
HF_HUB_OFFLINE=1
