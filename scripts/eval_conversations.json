          "language": "en"
        },
        {
          "say": "can you break that down into bullet points",
          "expect": "answers",
          "about": "water",
          "language": "en"
        }
      ]
    },
    {
      "name": "changing the subject",
      "turns": [
        {
          "say": "How do hurricanes form?",
