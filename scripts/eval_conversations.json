          "language": "en"
        },
        {
          "say": "explain more simply",
          "expect": "answers",
          "about": "hurricane",
          "language": "en"
        },
        {
          "say": "What about tornadoes?",
          "expect": "answers",
          "about": "tornado",
          "language": "en"
        },
        {
          "say": "and why are those dangerous?",
          "expect": "answers",
          "about": "tornado",
          "language": "en"
        }
      ]
    },
    {
      "name": "small talk in the middle of a lesson",
      "turns": [
        {
          "say": "hello good moring",
          "expect": "chats",
          "language": "en"
        },
        {
          "say": "What causes ocean waves?",
