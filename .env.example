# ---------------------------------------------------------------------------
# SECRETS AND CONNECTIONS ONLY.
#
# Anything you would tune while working — model choice, thresholds, k values,
# strategies — belongs in config.yaml, not here. If it is safe to commit, it
# does not go in this file.
#
# Copy to .env and fill in. .env is never committed.
# ---------------------------------------------------------------------------

# --- LLM provider credentials -----------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
COHERE_API_KEY=
VOYAGE_API_KEY=

# --- Vision / OCR model credentials -----------------------------------------
# For the vision comparison (scanned pages, maths, figure boxes) and the chosen
# vision model at runtime. OPENROUTER_API_KEY alone reaches Qwen, Gemini, Claude
# and Kimi through one endpoint — the simplest option. Fill the direct-provider
# keys only if you want to call a provider directly instead of via OpenRouter.
OPENROUTER_API_KEY=
MOONSHOT_API_KEY=          # Kimi / Moonshot direct (client-requested comparison)
DASHSCOPE_API_KEY=         # Qwen2.5-VL direct (Alibaba), optional
# ANTHROPIC_API_KEY and GOOGLE_API_KEY above are reused for Claude / Gemini direct.

# --- Voice ------------------------------------------------------------------
# Speech to text and text to speech, both ElevenLabs. The key needs the
# speech_to_text and text_to_speech permissions.
ELEVENLABS_API_KEY=

# --- Postgres ---------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/eduai

# --- Qdrant -----------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Object storage (syllabus files, figures, generated artifacts) ----------
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Platform backend API ---------------------------------------------------
# Point at the service-to-service prefix (…/api/ai-integration).
BACKEND_API_BASE_URL=http://localhost:8000/api/ai-integration
# Shared secret sent as the x-service-token header (same secret both directions).
AI_WEBHOOK_SHARED_SECRET=

# --- Tracing ----------------------------------------------------------------
LANGSMITH_API_KEY=

# --- Environment selector ---------------------------------------------------
# Picks the overlay block in config.yaml. local | staging | production
APP_ENV=local
