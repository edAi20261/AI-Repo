---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	classify(classify)
	load_context(load_context)
	plan(plan)
	explain_adapter(explain_adapter)
	summarize_adapter(summarize_adapter)
	assessment_adapter(assessment_adapter)
	grade_adapter(grade_adapter)
	report_adapter(report_adapter)
	visual_adapter(visual_adapter)
	render_visuals(render_visuals)
	compose(compose)
	persist(persist)
	__end__([<p>__end__</p>]):::last
	__start__ --> classify;
	assessment_adapter --> render_visuals;
	classify -.-> load_context;
	classify -.-> persist;
	compose --> persist;
	explain_adapter --> render_visuals;
	grade_adapter --> render_visuals;
	load_context --> plan;
	plan -.-> assessment_adapter;
	plan -.-> explain_adapter;
	plan -.-> grade_adapter;
	plan -.-> persist;
	plan -.-> report_adapter;
	plan -.-> summarize_adapter;
	plan -.-> visual_adapter;
	render_visuals --> compose;
	report_adapter --> render_visuals;
	summarize_adapter --> render_visuals;
	visual_adapter --> render_visuals;
	persist --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
